<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PKHeXMAUI.Geonet4Editor"
             Title="全球连接编辑器（第四世代）">
    <ScrollView>
        <VerticalStackLayout>
            <Grid ColumnDefinitions="*,*,*">
                <Button x:Name="B_SetAllLocations" Text="设置全部地点" Clicked="B_SetAllLocations_Clicked"/>
                <Button x:Name="B_SetAllLegalLocations" Text="设置全部合法地点" Clicked="B_SetAllLegalLocations_Clicked" Grid.Column="1"/>
                <Button x:Name="B_ClearAllLocations" Text="清除全部地点" Clicked="B_ClearAllLocations_Clicked" Grid.Column="2"/>
            </Grid>
            <CollectionView x:Name="CV_Geonet" HeightRequest="400"/>
            <Grid ColumnDefinitions="*,*">
                <CheckBox x:Name="CHK_GlobalFlag"/>
                <Label VerticalOptions="Center" Text="显示整个地球" Grid.Column="1"/>
            </Grid>
            <Grid ColumnDefinitions="*,*">
                <Button x:Name="B_Save" Text="保存" Clicked="B_Save_Clicked"/>
                <Button x:Name="B_Cancel" Text="取消" Clicked="B_Cancel_Clicked" Grid.Column="1"/>
            </Grid>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>