<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PKHeXMAUI.MiscFashionCase"
             Title="时尚盒">
    <ScrollView>
        <VerticalStackLayout>
            <Button x:Name="B_ClearAccessories" Text="删除全部配饰" Clicked="B_ClearAcessoriesClick"/>
            <Button x:Name="B_AllAccessoriesLegal" Text="添加全部合法配饰" Clicked="OnBAllAccessoriesLegalOnClick"/>
            <Button x:Name="B_AllAccessoriesIllegal" Text="添加全部非合法配饰" Clicked="OnBAllAccessoriesLegalOnClick"/>
            <CollectionView x:Name="CV_Accessories" HeightRequest="300"/>
            <Button x:Name="B_ClearBackdrops" Text="删除全部背景" Clicked="B_ClearBackdropsClick"/>
            <Button x:Name="B_AllBackdropsLegal" Text="添加全部合法背景" Clicked="OnBAllBackdropsLegalOnClick"/>
            <Button x:Name="B_AllBackdropsIllegal" Text="添加全部非合法背景" Clicked="OnBAllBackdropsLegalOnClick"/>
            <CollectionView x:Name="CV_Backdrops" HeightRequest="300"/>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>