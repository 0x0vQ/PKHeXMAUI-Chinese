<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PKHeXMAUI.RTC3Editor"
             Title="RTC 编辑器（第三世代）">
    <ScrollView>
    <VerticalStackLayout>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Label Text="初始时间"/>
                <Label Text="已用时间" Grid.Column="2"/>
                <Entry x:Name="InitialDayEntry" Keyboard="Numeric" Grid.Row="1"/>
                <Label Text="天" Grid.Row="1" Grid.Column="1"/>
                <Entry x:Name="ElapsedDayEntry" Grid.Column="2" Grid.Row="1" Keyboard="Numeric"/>
                <Label Text="天" Grid.Row="1" Grid.Column="3"/>
                <Entry x:Name="InitialHoursEntry" Grid.Row="2" Keyboard="Numeric"/>
                <Label Text="小时" Grid.Row="2" Grid.Column="1"/>
                <Entry x:Name="ElapsedHoursEntry" Grid.Row="2" Grid.Column="2" Keyboard="Numeric"/>
                <Label Text="小时" Grid.Row="2" Grid.Column="3"/>
                <Entry x:Name="InitialMinutesEntry" Grid.Row="3" Keyboard="Numeric"/>
                <Label Text="分钟" Grid.Row="3" Grid.Column="1"/>
                <Entry x:Name="ElapsedMinutesEntry" Grid.Row="3" Grid.Column="2" Keyboard="Numeric"/>
                <Label Text="分钟" Grid.Row="3" Grid.Column="3"/>
                <Entry x:Name="InitialSecondsEntry" Grid.Row="4" Keyboard="Numeric"/>
                <Label Text="秒" Grid.Row="4" Grid.Column="1"/>
                <Entry x:Name="ElapsedSecondsEntry" Grid.Row="4" Grid.Column="2" Keyboard="Numeric"/>
                <Label Text="秒" Grid.Row="4" Grid.Column="3"/>
                <Button Text="重置 RTC" Grid.Row="5" Clicked="ResetRTCClick"/>
                <Button Text="树果修复" Grid.Row="5" Grid.Column="1" Clicked="BerryFixClick"/>
                <Button Text="取消" Grid.Row="5" Grid.Column="2" Clicked="CloseRTC"/>
                <Button Text="保存" Grid.Row="5" Grid.Column="3" Clicked="SaveRTC"/>
            </Grid>
    </VerticalStackLayout>
    </ScrollView>
</ContentPage>