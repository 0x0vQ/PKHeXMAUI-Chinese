<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:l="clr-namespace:PKHeXMAUI"
             x:Class="PKHeXMAUI.TrainerEditor9Blueberry"
             Title="蓝莓学园">
    <VerticalStackLayout>
        <Label Text="蓝莓任务（BBQ）" HorizontalOptions="Center" />
        <Grid Padding="10" ColumnDefinitions="*,*,*">
            <Label Text="对战点数（BP）：" HorizontalOptions="End" VerticalOptions="Center"/>
            <Entry x:Name="BPEditor" Grid.Column="1"/>
            <Button Text="+" Clicked="MaxBP" Grid.Column="2"/>
        </Grid>
        <Grid Padding="10" ColumnDefinitions="*,*,*,*" RowDefinitions="*,*,*">
            <Label Text="单人任务：" HorizontalOptions="End" VerticalOptions="Center"/>
            <l:NumericUpDown x:Name="SQEditor" Grid.Column="1" HorizontalOptions="Start" VerticalOptions="Center" MinValue="0"/>
            <Label Text="团体任务：" HorizontalOptions="End" VerticalOptions="Center" Grid.Row="1"/>
            <l:NumericUpDown x:Name="GQEditor" Grid.Column="1" Grid.Row="1" MinValue="0"/>
            <Label Text="投球风格：" HorizontalOptions="End" VerticalOptions="Center" Grid.Row="2"/>
            <Picker x:Name="ThrowStylePicker" Grid.Row="2" Grid.Column="1"/>
        </Grid>
        <Button x:Name="ActivateLegendsButton" Text="启用传说宝可梦" Clicked="UnlockLegends"/>
        <Button Text="解锁全部教练" x:Name="CoachesButton" Clicked="UnlockCoaches"/>
        <Button Text="解锁全部投球风格" x:Name="ThrowStyleButton" Clicked="UnlockThrowStyles"/>
    </VerticalStackLayout>
</ContentPage>