<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:l="clr-namespace:PKHeXMAUI"
             x:Class="PKHeXMAUI.TrainerEditor7BattleTree"
             Title="对战树">
    <VerticalStackLayout>
        <Grid Padding="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Label Text="普通" Grid.ColumnSpan="2" VerticalOptions="Center" HorizontalOptions="Center"/>
            <Label Text="超级" Grid.Column="2" VerticalOptions="Center"/>
            <Label Text="单打当前连胜：" Grid.Row="1" VerticalOptions="Center"/>
            <l:NumericUpDown x:Name="CSSNEntry" Grid.Row="1" Grid.Column="1"/>
            <l:NumericUpDown x:Name="CSSSEntry" Grid.Row="1" Grid.Column="2"/>
            <Label Text="单打最高连胜：" Grid.Row="2" VerticalOptions="Center"/>
            <l:NumericUpDown x:Name="MSSNEntry" Grid.Row="2" Grid.Column="1"/>
            <l:NumericUpDown x:Name="MSSSEntry" Grid.Row="2" Grid.Column="2"/>
            <Label Text="双打当前连胜：" Grid.Row="3" VerticalOptions="Center"/>
            <l:NumericUpDown x:Name="CSDNEntry" Grid.Row="3" Grid.Column="1"/>
            <l:NumericUpDown x:Name="CSDSEntry" Grid.Row="3" Grid.Column="2"/>
            <Label Text="双打最高连胜：" Grid.Row="4" VerticalOptions="Center"/>
            <l:NumericUpDown x:Name="MSDNEntry" Grid.Row="4" Grid.Column="1"/>
            <l:NumericUpDown x:Name="MSDSEntry" Grid.Row="4" Grid.Column="2"/>
            <Label Text="多人对战当前连胜：" Grid.Row="5" VerticalOptions="Center"/>
            <l:NumericUpDown x:Name="CSMNEntry" Grid.Row="5" Grid.Column="1"/>
            <l:NumericUpDown x:Name="CSMSEntry" Grid.Row="5" Grid.Column="2"/>
            <Label Text="多人对战最高连胜：" Grid.Row="6" VerticalOptions="Center"/>
            <l:NumericUpDown x:Name="MSMNEntry" Grid.Row="6" Grid.Column="1"/>
            <l:NumericUpDown x:Name="MSMSEntry" Grid.Row="6" Grid.Column="2"/>
        </Grid>
        <Grid Padding="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Label Text="解锁超级模式*" VerticalOptions="Center"/>
            <CheckBox x:Name="SuperSingleCheck" Grid.Row="1"/>
            <Label Text="单打" Grid.Row="1" Grid.Column="1" VerticalOptions="Center"/>
            <CheckBox x:Name="SuperDoubleCheck" Grid.Row="1" Grid.Column="2"/>
            <Label Text="双打" Grid.Row="1" Grid.Column="3" VerticalOptions="Center"/>
            <CheckBox x:Name="SuperMultiCheck" Grid.Row="1" Grid.Column="4"/>
            <Label Text="多人对战" Grid.Row="1" Grid.Column="5" VerticalOptions="Center"/>
        </Grid>
    </VerticalStackLayout>
</ContentPage>