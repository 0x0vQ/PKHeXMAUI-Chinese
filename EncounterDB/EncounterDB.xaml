<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
            
             x:Class="PKHeXMAUI.EncounterDB"
             Title="遭遇数据库">
    <VerticalStackLayout>
        <Button Text="搜索设置" Clicked="SetSearchSettings"/>
        <Button Text="搜索" Clicked="SearchEncountersClick"/>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="自动"></RowDefinition>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="自动"/>
            </Grid.ColumnDefinitions>
            <CollectionView HeightRequest="375" WidthRequest="400" x:Name="EncounterCollection" SelectionMode="单打" ></CollectionView>
        </Grid>
    </VerticalStackLayout>
</ContentPage>