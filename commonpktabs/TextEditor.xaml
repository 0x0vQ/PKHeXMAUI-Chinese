<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:control="clr-namespace:PKHeXMAUI"
             x:Class="PKHeXMAUI.TextEditor"
             Title="文本编辑器">
    <ScrollView>
        <VerticalStackLayout>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Label Text="字符串" VerticalOptions="Center" HorizontalOptions="Center"/>
                    <Entry x:Name="StringEntry" Grid.Column="1"/>
                    <CollectionView x:Name="StringHexCV" Grid.Row="1" Grid.ColumnSpan="2" HeightRequest="250"/>
                    <CollectionView x:Name="SpecialStringCV" Grid.Row="2" Grid.ColumnSpan="2" HeightRequest="250"/>
                </Grid>
                <Grid Grid.Column="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Label Text="垃圾字节层" VerticalOptions="Center" HorizontalOptions="Center"/>
                    <Label Text="宝可梦种类" Grid.Row="1" HorizontalOptions="Center" VerticalOptions="Center"/>
                    <control:comboBox x:Name="SpeciesCombo" Grid.Row="1" Grid.Column="1"/>
                    <Label Text="语言" Grid.Row="2" VerticalOptions="Center" HorizontalOptions="Center"/>
                    <Picker x:Name="LanguagePicker" Grid.Row="2" Grid.Column="1"/>
                    <Label Text="世代" Grid.Row="3" VerticalOptions="Center" HorizontalOptions="Center"/>
                    <Picker x:Name="GenerationPicker" Grid.Row="3" Grid.Column="1"/>
                    <Button Text="清除无效数据" Grid.Row="4" Clicked="B_ClearTrash_Click"/>
                    <Button Text="应用无效数据" Grid.Row="4" Grid.Column="1" Clicked="B_ApplyTrash_Click"/>
                    <Button Text="取消" Clicked="CloseTextEditor" Grid.Row="5"/>
                    <Button Text="保存" Grid.Row="5" Grid.Column="1" Clicked="B_Save_Click"/>
                    
                </Grid>
            </Grid>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>