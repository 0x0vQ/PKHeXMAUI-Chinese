<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PKHeXMAUI.RibbonSelector"
             Title="奖章选择器">
    <RefreshView x:Name="ribbonrefresh">
    <VerticalStackLayout>
        <CollectionView HeightRequest="500" WidthRequest="400" x:Name="ribboncollection" SelectionMode="Multiple" ></CollectionView>
        <Button x:Name="affixribbons" Text="显示奖章" Clicked="AffixRibbon"></Button>
        <Button x:Name="applyribbons" Text="应用" Clicked="applyribbonsandclose"></Button>
        <Button x:Name="close" Text="关闭" Clicked="closer"/>
    </VerticalStackLayout>
    </RefreshView>
</ContentPage>